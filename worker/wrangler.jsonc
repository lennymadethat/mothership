{
  // The hub. One worker, one surface. Replace every YOUR_* value.
  // Secrets (npx wrangler secret put): HUB_TOKEN (required; the hub answers nothing without it),
  // VAPID_PRIVATE_JWK + VAPID_PUBLIC_KEY (optional, push notifications).
  "name": "mothership-hub",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "assets": { "directory": "../web", "binding": "ASSETS" },
  "workers_dev": true,
  // Optional custom domain: "routes": [{ "pattern": "mothership.your-domain.com", "custom_domain": true }],
  "routes": [],
  "durable_objects": {
    "bindings": [{ "name": "MACHINES", "class_name": "MachineRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MachineRelay"] }],
  "kv_namespaces": [{ "binding": "HUB_KV", "id": "YOUR_KV_NAMESPACE_ID" }],
  "vars": { "ACCOUNT_ID": "YOUR_CLOUDFLARE_ACCOUNT_ID" },
  "observability": { "enabled": true }
}
